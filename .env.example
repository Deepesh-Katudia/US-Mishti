# Supabase (Project Settings → API). Server-only — never prefix with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL used for metadata / Open Graph
NEXT_PUBLIC_SITE_URL=https://usmishti.com

# Anthropic — AI diamond concierge (server-only; never prefix with NEXT_PUBLIC_)
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional overrides
# ANTHROPIC_MODEL=claude-opus-5-5
# CHAT_DAILY_BUDGET_USD=5
# CHAT_VISITOR_SALT=change-me-to-a-random-string

# Concierge mode: "scripted" (default — predefined answers, no API key needed) or "ai" (uses ANTHROPIC_API_KEY)
# CHAT_MODE=scripted
